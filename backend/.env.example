# MongoDB connection string
MONGO_URI=

# Port the backend listens on (optional, defaults to 5000)
PORT=5000

# Secret used to sign JWT auth tokens
JWT_SECRET=

# Google Gemini API key, used by the AI chatbot endpoint
GEMINI_API_KEY=

# --- Volunteer booking confirmation emails ---
# SMTP credentials used to email volunteers when they book a slot.
# If left blank, booking still works — the email is just skipped (and logged).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
